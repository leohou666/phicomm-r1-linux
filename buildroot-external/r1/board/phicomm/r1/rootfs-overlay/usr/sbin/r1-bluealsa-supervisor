#!/bin/sh

BLUEALSA_ARGS="-p a2dp-sink"
BLUEALSA_APLAY_ARGS="-D r1-output 00:00:00:00:00:00"

# shellcheck source=/dev/null
[ -r /etc/default/bluealsa ] && . /etc/default/bluealsa
# shellcheck source=/dev/null
[ -r /etc/default/bluealsa-aplay ] && . /etc/default/bluealsa-aplay

running=1
bluealsa_pid=
aplay_pid=

log()
{
	printf 'r1-bluealsa-supervisor: %s\n' "$*"
}

alive()
{
	[ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

dependencies_ready()
{
	pidof dbus-daemon >/dev/null 2>&1 && pidof bluetoothd >/dev/null 2>&1
}

stop_aplay()
{
	if alive "$aplay_pid"; then
		kill "$aplay_pid" 2>/dev/null || true
		wait "$aplay_pid" 2>/dev/null || true
	fi
	aplay_pid=
}

stop_bluealsa()
{
	if alive "$bluealsa_pid"; then
		kill "$bluealsa_pid" 2>/dev/null || true
		wait "$bluealsa_pid" 2>/dev/null || true
	fi
	bluealsa_pid=
}

stop_stack()
{
	stop_aplay
	stop_bluealsa
}

start_bluealsa()
{
	# shellcheck disable=SC2086
	/usr/bin/bluealsa $BLUEALSA_ARGS &
	bluealsa_pid=$!
	log "bluealsa started pid=$bluealsa_pid"

	ready=0
	count=0
	while [ "$running" -eq 1 ] && [ "$count" -lt 20 ]; do
		if ! alive "$bluealsa_pid"; then
			wait "$bluealsa_pid" 2>/dev/null
			status=$?
			log "bluealsa exited during startup status=$status"
			bluealsa_pid=
			return 1
		fi
		if /usr/bin/bluealsa-aplay -L >/dev/null 2>&1; then
			ready=1
			break
		fi
		count=$((count + 1))
		sleep 1
	done

	[ "$ready" -eq 1 ] || {
		log "bluealsa D-Bus service did not become ready"
		return 1
	}
}

start_aplay()
{
	# shellcheck disable=SC2086
	/usr/bin/bluealsa-aplay $BLUEALSA_APLAY_ARGS &
	aplay_pid=$!
	log "bluealsa-aplay started pid=$aplay_pid"
}

trap 'running=0' HUP INT TERM
trap 'stop_stack' EXIT

# This image owns the entire audio service stack.  Remove stale/manual
# instances once at supervisor startup so exactly one endpoint owner and one
# ALSA consumer remain.  Diagnostic users can stop this service first.
killall bluealsa-aplay 2>/dev/null || true
killall bluealsa 2>/dev/null || true
sleep 1

while [ "$running" -eq 1 ]; do
	if ! dependencies_ready; then
		stop_stack
		sleep 1
		continue
	fi

	if ! alive "$bluealsa_pid"; then
		stop_stack
		if ! start_bluealsa; then
			stop_stack
			sleep 1
			continue
		fi
	fi

	if ! alive "$aplay_pid"; then
		if [ -n "$aplay_pid" ]; then
			wait "$aplay_pid" 2>/dev/null
			status=$?
			log "bluealsa-aplay exited status=$status; restarting"
			aplay_pid=
		fi
		start_aplay
	fi

	sleep 1
done

log "stopping"
