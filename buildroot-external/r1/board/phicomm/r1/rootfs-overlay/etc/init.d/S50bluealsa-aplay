#!/bin/sh

DAEMON=bluealsa-aplay
EXEC=/usr/bin/bluealsa-aplay
PIDFILE=/var/run/$DAEMON.pid
BLUEALSA_APLAY_ARGS="-D r1-output 00:00:00:00:00:00"

# shellcheck source=/dev/null
[ -r /etc/default/bluealsa-aplay ] && . /etc/default/bluealsa-aplay

start() {
	printf 'Starting %s: ' "$DAEMON"
	# shellcheck disable=SC2086
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$EXEC" -- $BLUEALSA_APLAY_ARGS
	status=$?
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

stop() {
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE" --exec "$EXEC"
	status=$?
	while start-stop-daemon --stop --test --quiet \
		--pidfile "$PIDFILE" --exec "$EXEC"; do
		sleep 0.1
	done
	rm -f "$PIDFILE"
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
