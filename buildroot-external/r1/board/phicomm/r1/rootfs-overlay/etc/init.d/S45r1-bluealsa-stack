#!/bin/sh

DAEMON=r1-bluealsa-supervisor
EXEC=/usr/sbin/$DAEMON
PIDFILE=/var/run/$DAEMON.pid
LOGFILE=/var/log/$DAEMON.log

start()
{
	printf 'Starting %s: ' "$DAEMON"
	if start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE"; then
		echo already-running
		return 0
	fi
	rm -f "$PIDFILE"
	start-stop-daemon --start --background --make-pidfile \
		--pidfile "$PIDFILE" --exec "$EXEC" --output "$LOGFILE"
	status=$?
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

stop()
{
	printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE"
	status=$?
	count=0
	while start-stop-daemon --stop --test --quiet --pidfile "$PIDFILE"; do
		[ "$count" -lt 50 ] || break
		count=$((count + 1))
		sleep 0.1
	done
	rm -f "$PIDFILE"
	[ "$status" -eq 0 ] && echo OK || echo FAIL
	return "$status"
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
