diff --git a/common/xyzModem.c b/common/xyzModem.c
--- a/common/xyzModem.c
+++ b/common/xyzModem.c
@@ -67,16 +67,37 @@ static int
 CYGACC_COMM_IF_GETC_TIMEOUT (char chan, char *c)
 {
   ulong now = get_timer(0);
+
+#if defined(CONFIG_SPL_BUILD) && defined(CONFIG_TARGET_PHICOMM_R1)
+  /*
+   * The generic console path is too slow for a continuous 1.5-Mbaud burst:
+   * an empty tstc() window may call schedule() while the 64-byte UART FIFO is
+   * filling.  The vendor 471 stage and R1 board init already configure UART2
+   * as 1500000 8N1 with 32-bit, register-shift-2 accesses.  Poll it directly
+   * for the RAM-only SPL YMODEM path so the host does not need per-byte gaps.
+   */
+  volatile u32 *uart = (volatile u32 *)0x11030000;
+
+  while (!(uart[5] & 1U))
+    {
+      if (get_timer(now) > xyzModem_CHAR_TIMEOUT)
+        return 0;
+    }
+
+  *c = uart[0] & 0xff;
+  return 1;
+#else
   while (!tstc ())
     {
       schedule();
       if (get_timer(now) > xyzModem_CHAR_TIMEOUT)
         break;
     }
   if (tstc ())
     {
       *c = getchar();
       return 1;
     }
   return 0;
+#endif
 }
