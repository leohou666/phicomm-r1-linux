diff --git a/dts/upstream/src/arm/rockchip/rk3229-phicomm-r1.dts b/dts/upstream/src/arm/rockchip/rk3229-phicomm-r1.dts
new file mode 100644
--- /dev/null
+++ b/dts/upstream/src/arm/rockchip/rk3229-phicomm-r1.dts
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/dts-v1/;
+
+#include "rk3229.dtsi"
+
+/ {
+	model = "Phicomm R1";
+	compatible = "phicomm,r1", "rockchip,rk3229";
+
+	aliases {
+		mmc0 = &emmc;
+		serial2 = &uart2;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	memory@60000000 {
+		device_type = "memory";
+		reg = <0x60000000 0x20000000>;
+	};
+};
+
+&emmc {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	non-removable;
+	status = "okay";
+};
+
+&uart2 {
+	current-speed = <1500000>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart21_xfer>;
+	status = "okay";
+};
diff --git a/arch/arm/dts/rk3229-phicomm-r1-u-boot.dtsi b/arch/arm/dts/rk3229-phicomm-r1-u-boot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm/dts/rk3229-phicomm-r1-u-boot.dtsi
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk322x-u-boot.dtsi"
+
+/ {
+	chosen {
+		stdout-path = &uart2;
+	};
+};
+
+/* The vendor 0x471 stage has already trained DRAM and configured UART2. */
+&uart2 {
+	bootph-all;
+};
