From: Phicomm R1 Linux contributors
Subject: [PATCH] sound: soc: codecs: add AK7755 safe firmware verifier

Wire the project-maintained AK7755 source overlay into Kconfig and Kbuild.
The source and binding are installed by prepare-kernel-source.sh before
this patch is applied.

---
 sound/soc/codecs/Kconfig  | 11 +++++++++++
 sound/soc/codecs/Makefile | 1 +
 2 files changed, 12 insertions(+)

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index 9d2969a..f8f6b1d 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -593,6 +593,17 @@ config SND_SOC_AK4118
 	depends on I2C
 	select REGMAP_I2C
 
+config SND_SOC_AK7755
+	tristate "AKM AK7755 audio DSP safe firmware verifier"
+	depends on I2C
+	select FW_LOADER
+	help
+	  Enable the initial AK7755 I2C component.  It verifies the device ID,
+	  downloads PRAM and CRAM firmware, and checks the hardware CRC while
+	  deliberately leaving the DSP stopped and exposing no PCM DAI.
+	  This is a bring-up option: a later driver stage will add the normal
+	  audio interface only after the board clock contract is verified.
+
 config SND_SOC_AK4375
 	tristate "AKM AK4375 CODEC"
 	depends on I2C
diff --git a/sound/soc/codecs/Makefile b/sound/soc/codecs/Makefile
index c1fd7dc..8e7bed1 100644
--- a/sound/soc/codecs/Makefile
+++ b/sound/soc/codecs/Makefile
@@ -465,6 +465,7 @@ obj-$(CONFIG_SND_SOC_ADAV803)  += snd-soc-adav803.o
 obj-$(CONFIG_SND_SOC_ADS117X)	+= snd-soc-ads117x.o
 obj-$(CONFIG_SND_SOC_AK4104)	+= snd-soc-ak4104.o
 obj-$(CONFIG_SND_SOC_AK4118)	+= snd-soc-ak4118.o
+obj-$(CONFIG_SND_SOC_AK7755)	+= ak7755.o
 obj-$(CONFIG_SND_SOC_AK4375)	+= snd-soc-ak4375.o
 obj-$(CONFIG_SND_SOC_AK4458)	+= snd-soc-ak4458.o
 obj-$(CONFIG_SND_SOC_AK4535)	+= snd-soc-ak4535.o
-- 
