diff --git a/arch/arm/Kconfig.debug b/arch/arm/Kconfig.debug
index dd1cf7035..3f3dffbeb 100644
--- a/arch/arm/Kconfig.debug
+++ b/arch/arm/Kconfig.debug
@@ -1954,6 +1954,22 @@ config EARLY_PRINTK
 	  kernel low-level debugging functions. Add earlyprintk to your
 	  kernel parameters to enable this console.
 
+config PHICOMM_R1_SECONDARY_UART_TRACE
+	bool "Phicomm R1 secondary CPU UART breadcrumbs"
+	depends on DEBUG_LL && DEBUG_LL_UART_8250
+	help
+	  Emit A through R from the ARM secondary CPU startup path. Lower-case
+	  a/s/t/b/w/x/o/p mark CPU0's PSCI CPU_ON call and completion-wait return.
+	  With this diagnostic enabled, CPU0 polls the completion rather than
+	  sleeping, solely to isolate wakeup/IRQ failures during bring-up. It also
+	  emits S-V around the CPU1 hotplug-idle completion and y/z around CPU0's
+	  corresponding wait, then 0-3 around CPU0 hotplug-thread activation and
+	  i/j/k around a CPU1 reschedule IPI send/receive/return.
+	  A-D use DEBUG_UART_PHYS before the MMU is enabled; E uses
+	  DEBUG_UART_VIRT after the MMU transition. This is solely a local
+	  RK3229/OP-TEE bring-up diagnostic and must stay disabled for normal
+	  kernels.
+
 config ARM_KPROBES_TEST
 	tristate "Kprobes test module"
 	depends on KPROBES && MODULES
diff --git a/arch/arm/kernel/head.S b/arch/arm/kernel/head.S
index 4af5c7679..0d220f215 100644
--- a/arch/arm/kernel/head.S
+++ b/arch/arm/kernel/head.S
@@ -24,6 +24,26 @@
 #include CONFIG_DEBUG_LL_INCLUDE
 #endif
 
+#ifdef CONFIG_PHICOMM_R1_SECONDARY_UART_TRACE
+	/* r0/r1 are scratch at all trace sites below. */
+	.macro	r1_secondary_trace_phys, value
+	ldr	r0, =CONFIG_DEBUG_UART_PHYS
+	mov	r1, #\value
+	str	r1, [r0]
+	.endm
+
+	.macro	r1_secondary_trace_virt, value
+	ldr	r0, =CONFIG_DEBUG_UART_VIRT
+	mov	r1, #\value
+	str	r1, [r0]
+	.endm
+#else
+	.macro	r1_secondary_trace_phys, value
+	.endm
+	.macro	r1_secondary_trace_virt, value
+	.endm
+#endif
+
 /*
  * swapper_pg_dir is the virtual address of the initial page table.
  * We place the page tables 16K below KERNEL_RAM_VADDR.  Therefore, we must
@@ -375,10 +395,12 @@ ENTRY(secondary_startup)
 
  ARM_BE8(setend	be)				@ ensure we are in BE8 mode
 
+	r1_secondary_trace_phys	'A'
 #ifdef CONFIG_ARM_VIRT_EXT
 	bl	__hyp_stub_install_secondary
 #endif
 	safe_svcmode_maskall r9
+	r1_secondary_trace_phys	'B'
 
 	mrc	p15, 0, r9, c0, c0		@ get processor id
 	bl	__lookup_processor_type
@@ -387,6 +409,7 @@ ENTRY(secondary_startup)
  THUMB( it	eq )		@ force fixup-able long branch encoding
 	beq	__error_p
 
+	r1_secondary_trace_phys	'C'
 	/*
 	 * Use the page tables supplied from  __cpu_up.
 	 */
@@ -400,6 +423,7 @@ ARM_BE8(eor	r5, r4, r5)			@ it can be done in 3 steps
 ARM_BE8(eor	r4, r4, r5)			@ without using a temp reg.
 	ldr	r8, [r3, #8]			@ get secondary_data.swapper_pg_dir
 	badr	lr, __enable_mmu		@ return address
+	r1_secondary_trace_phys	'D'
 	mov	r13, r12			@ __secondary_switched address
 	ldr	r12, [r10, #PROCINFO_INITFUNC]
 	add	r12, r12, r10			@ initialise processor
@@ -412,6 +436,7 @@ ENDPROC(secondary_startup_arm)
 	 * r6  = &secondary_data
 	 */
 ENTRY(__secondary_switched)
+	r1_secondary_trace_virt	'E'
 	ldr	sp, [r7, #12]			@ get secondary_data.stack
 	mov	fp, #0
 	b	secondary_start_kernel
diff --git a/arch/arm/kernel/psci_smp.c b/arch/arm/kernel/psci_smp.c
index d4392e177..b86169efc 100644
--- a/arch/arm/kernel/psci_smp.c
+++ b/arch/arm/kernel/psci_smp.c
@@ -42,11 +42,28 @@
 
 extern void secondary_startup(void);
 
+#ifdef CONFIG_PHICOMM_R1_SECONDARY_UART_TRACE
+static __always_inline void r1_psci_trace(char marker)
+{
+	*(volatile u32 *)CONFIG_DEBUG_UART_VIRT = marker;
+}
+#else
+static __always_inline void r1_psci_trace(char marker)
+{
+}
+#endif
+
 static int psci_boot_secondary(unsigned int cpu, struct task_struct *idle)
 {
-	if (psci_ops.cpu_on)
-		return psci_ops.cpu_on(cpu_logical_map(cpu),
-					virt_to_idmap(&secondary_startup));
+	int ret;
+
+	if (psci_ops.cpu_on) {
+		r1_psci_trace('s');
+		ret = psci_ops.cpu_on(cpu_logical_map(cpu),
+					     virt_to_idmap(&secondary_startup));
+		r1_psci_trace('t');
+		return ret;
+	}
 	return -ENODEV;
 }
 
