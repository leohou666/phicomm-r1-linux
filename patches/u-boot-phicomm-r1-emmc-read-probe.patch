diff --git a/common/spl/spl_mmc.c b/common/spl/spl_mmc.c
index d9f5a355d8e..ab80889f442 100644
--- a/common/spl/spl_mmc.c
+++ b/common/spl/spl_mmc.c
@@ -15,15 +15,28 @@
 #include <mmc.h>
 #include <image.h>
 #include <imx_container.h>
 
+static bool r1_mmc_first_read_logged;
+
 static ulong h_spl_load_read(struct spl_load_info *load, ulong off,
 			     ulong size, void *buf)
 {
 	struct blk_desc *bd = load->priv;
 	lbaint_t sector = off >> bd->log2blksz;
 	lbaint_t count = size >> bd->log2blksz;
+	ulong blocks;
+
+	blocks = blk_dread(bd, sector, count, buf);
+	if (!r1_mmc_first_read_logged) {
+		const u8 *header = buf;
+
+		r1_mmc_first_read_logged = true;
+		printf("R1MMC sector=%lx count=%lx got=%lx hdr=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+		       sector, count, blocks, header[0], header[1], header[2],
+		       header[3], header[4], header[5], header[6], header[7]);
+	}
 
-	return blk_dread(bd, sector, count, buf) << bd->log2blksz;
+	return blocks << bd->log2blksz;
 }
 
