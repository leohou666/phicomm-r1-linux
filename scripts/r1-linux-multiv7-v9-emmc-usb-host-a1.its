/dts-v1/;

/*
 * USB Host A1: exact verified C1 kernel/initramfs, with only the DTB changed.
 */
/ {
	description = "Phicomm R1 Linux 5.10 C1 plus USB Host A1";
	#address-cells = <1>;

	images {
		kernel {
			description = "Verified Linux 5.10.262 multi_v7 clean four-core v9";
			data = /incbin/("../build/artifacts/zImage-5.10-psci-v1-gic400-clean-4core-v9");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x62000000>;
			entry = <0x62000000>;
			hash-1 { algo = "sha256"; };
		};

		ramdisk {
			description = "R1 rescue initramfs with basic applets";
			data = /incbin/("../build/artifacts/r1-initramfs-rescue-v11-emmc-a2.cpio.gz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x64000000>;
			hash-1 { algo = "sha256"; };
		};

		fdt {
			description = "Verified eMMC C1 DT plus fixed USB Host controllers";
			data = /incbin/("../build/artifacts/rk3229-phicomm-r1-emmc-open-optee-usb-host-a1.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x65000000>;
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "config-1";

		config-1 {
			description = "R1 C1 plus USB Host A1";
			kernel = "kernel";
			ramdisk = "ramdisk";
			fdt = "fdt";
		};
	};
};
