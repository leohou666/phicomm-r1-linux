/dts-v1/;

/* Bluetooth A1r3: A1r2 plus asserted GPIO3_D3 BT_WAKE. */
/ {
	description = "Phicomm R1 Linux 5.10 Bluetooth UART A1r3";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux 5.10.262 multi_v7 four-core Wi-Fi A3 kernel";
			data = /incbin/("../build/artifacts/zImage-5.10-multiv7-v9-wifi-a3");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x62000000>;
			entry = <0x62000000>;
			hash-1 { algo = "sha256"; };
		};

		ramdisk {
			description = "R1 Wi-Fi A3b rescue initramfs with UART probe applets";
			data = /incbin/("../build/artifacts/r1-initramfs-wifi-bt-uart-a1.cpio.gz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x64000000>;
			hash-1 { algo = "sha256"; };
		};

		fdt {
			description = "R1 Bluetooth UART A1r3 BT_REG_ON plus BT_WAKE DT";
			data = /incbin/("../build/artifacts/rk3229-phicomm-r1-wifi-bt-uart-a1r3.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x65000000>;
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "config-1";

		config-1 {
			description = "R1 Bluetooth raw UART A1r3";
			kernel = "kernel";
			ramdisk = "ramdisk";
			fdt = "fdt";
		};
	};
};
