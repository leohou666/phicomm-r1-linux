/dts-v1/;

/ {
	description = "Phicomm R1 Linux 5.10 AK7755EN identity A2";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "Linux 5.10.262 R1 Bluetooth CMAC/AES built-in";
			data = /incbin/("../build/artifacts/zImage-wifi-bt-mgmt-a1r9");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x62000000>;
			entry = <0x62000000>;
			hash-1 { algo = "sha256"; };
		};

		ramdisk-1 {
			description = "R1 rescue initramfs with AK7755EN identity tool";
			data = /incbin/("../build/artifacts/r1-initramfs-wifi-bt-audio-ak7755-a2.cpio.gz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "gzip";
			hash-1 { algo = "sha256"; };
		};

		fdt-1 {
			description = "Phicomm R1 safe amplifier GPIO plus AK7755EN PDN DTB";
			data = /incbin/("../build/artifacts/rk3229-phicomm-r1-wifi-bt-audio-ak7755-a2.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "config-1";
		config-1 {
			description = "R1 AK7755EN 0x60 identity-read A2";
			kernel = "kernel-1";
			ramdisk = "ramdisk-1";
			fdt = "fdt-1";
		};
	};
};
