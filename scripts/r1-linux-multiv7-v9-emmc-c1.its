/dts-v1/;

/*
 * C1 config A/B after the trimmed v11 kernel failed to bring CPU1-CPU3
 * online with the eMMC B2 device tree.
 *
 * Reuse the exact multi_v7-based clean-v9 zImage already verified with four
 * CPUs.  Keep the B2 timer-minimal DTB and fixed initramfs byte-for-byte.
 */
/ {
	description = "Phicomm R1 Linux 5.10 multi_v7 v9 eMMC C1";
	#address-cells = <1>;

	images {
		kernel {
			description = "Verified Linux 5.10.262 multi_v7 clean four-core v9";
			data = /incbin/("../build/artifacts/zImage-5.10-psci-v1-gic400-clean-4core-v9");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x62000000>;
			entry = <0x62000000>;
			hash-1 { algo = "sha256"; };
		};

		ramdisk {
			description = "R1 rescue initramfs with basic applets";
			data = /incbin/("../build/artifacts/r1-initramfs-rescue-v11-emmc-a2.cpio.gz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x64000000>;
			hash-1 { algo = "sha256"; };
		};

		fdt {
			description = "R1 eMMC B2 timer-minimal DT";
			data = /incbin/("../build/artifacts/rk3229-phicomm-r1-rescue-v11-emmc-a2-timer-minimal.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x65000000>;
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "config-1";

		config-1 {
			description = "R1 multi_v7 v9 kernel plus eMMC B2 DT";
			kernel = "kernel";
			ramdisk = "ramdisk";
			fdt = "fdt";
		};
	};
};
