/dts-v1/;

/ {
	description = "Phicomm R1 factory Linux 3.10 AK7755 A/B A21r3";
	#address-cells = <1>;

	images {
		kernel-1 {
			description = "Locally preserved R1 factory Linux 3.10 kernel";
			data = /incbin/("../backup/unpacked/boot/kernel");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x60408000>;
			entry = <0x60408000>;
			hash-1 { algo = "sha256"; };
		};

		ramdisk-1 {
			description = "Read-only R1 rescue initramfs with zero-PCM tool";
			data = /incbin/("../build/artifacts/r1-initramfs-mainline-6.18-ak7755-i2s-clock-a19.cpio.gz");
			type = "ramdisk";
			arch = "arm";
			os = "linux";
			compression = "gzip";
			hash-1 { algo = "sha256"; };
		};

		fdt-1 {
			description = "Factory AK7755 audio DT; storage/wireless/other cards disabled";
			data = /incbin/("../build/artifacts/rk3229-phicomm-r1-factory-open-optee-audio-only-a21r3.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 { algo = "sha256"; };
		};
	};

	configurations {
		default = "config-1";

		config-1 {
			description = "Factory AK7755 card-0 zero-PCM comparison";
			kernel = "kernel-1";
			ramdisk = "ramdisk-1";
			fdt = "fdt-1";
		};
	};
};
