# Phicomm R1 eMMC peripheral layer for Linux 5.10.
#
# The v11 rescue fragment already carries these options as a transitional
# convenience.  Keep this ownership layer separate so a later rescue-core
# baseline can drop storage/power drivers without losing the reproducible
# eMMC bring-up configuration.

CONFIG_LOCALVERSION="-phicomm-r1-rescue-v11-emmc-a1"

CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

CONFIG_PINCTRL=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RK808=y

# Read-only inspection starts with the native MMC block device.  ext4 is kept
# for later explicit mounts, but the rescue init does not auto-mount eMMC.
CONFIG_EXT4_FS=y
