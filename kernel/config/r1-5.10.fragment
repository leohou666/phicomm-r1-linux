# Linux 5.10's multi_v7_defconfig selects the ARM per-task stack-canary GCC
# plugin. The available cross compiler's plugin headers require host gmp.h,
# which is not installed. Keep the normal strong stack protector, but avoid
# this optional build-host plugin.
# CONFIG_GCC_PLUGINS is not set
# CONFIG_STACKPROTECTOR_PER_TASK is not set

# In 5.10, enabling cfg80211 also enables a hidden signed-regdb option, which
# selects the system certificate keyring and builds an OpenSSL host helper.
# The minimal diagnostic DT has no Wi-Fi node, so omit cfg80211 and its unused
# certificate plumbing from this version-comparison image.
# CONFIG_CFG80211 is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set

# The 5.10 open-source OP-TEE test needs to identify CPU1's exact first-stop
# point. This emits A/B/C/D/E only from secondary_startup.
CONFIG_PHICOMM_R1_SECONDARY_UART_TRACE=y
