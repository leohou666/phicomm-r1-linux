CONFIG_LOCALVERSION="-phicomm-r1"
CONFIG_CMDLINE="earlyprintk console=ttyS2,1500000n8 loglevel=8 ignore_loglevel maxcpus=2 cpufreq.off=1 nohz=off clocksource.arm_arch_timer.evtstrm=0 rdinit=/init"
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
CONFIG_CMDLINE_FORCE=y

CONFIG_ARCH_ROCKCHIP=y
CONFIG_CLK_RK322X=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# This image targets one fixed board and UART. Keep decompressor diagnostics
# enabled until the first mainline boot reaches the normal early console.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_LL_UART_8250=y
CONFIG_DEBUG_UART_PHYS=0x11030000
CONFIG_DEBUG_UART_VIRT=0xfed30000
CONFIG_DEBUG_UART_8250_SHIFT=2
CONFIG_DEBUG_UART_8250_WORD=y
CONFIG_DEBUG_UNCOMPRESS=y
CONFIG_EARLY_PRINTK=y

CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_RK808=y

CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y

# Persist the last per-CPU function calls across a warm watchdog reset.
CONFIG_FUNCTION_TRACER=y
CONFIG_PSTORE_FTRACE=y

CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
